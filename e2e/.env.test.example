# Copie para .env.test (já ignorado pelo git) e preencha com os dados do
# branch/projeto Neon de TESTE — nunca use a DATABASE_URL de produção aqui.

# Connection string do branch Neon isolado para testes E2E
E2E_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Qualquer string >= 32 caracteres. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
E2E_JWT_SECRET=

# Qualquer string — usada só pelo teste do disparo preventivo via cron
E2E_CRON_SECRET=e2e-cron-secret-de-teste

# Portas locais (defaults abaixo funcionam na maioria dos casos)
E2E_FRONTEND_PORT=4173
E2E_BACKEND_PORT=3099
